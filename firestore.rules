rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validLevel(level) {
      return level in ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'];
    }

    function validProfile(profile, userId) {
      return profile.uid == userId
        && profile.displayName is string
        && profile.displayName.size() > 0
        && profile.displayName.size() <= 80
        && profile.email is string
        && profile.email.size() <= 254
        && validLevel(profile.cefrLevel)
        && profile.completedLessons is int
        && profile.completedLessons >= 0
        && (!('completedByLevelA1' in profile) || (profile.completedByLevelA1 is int && profile.completedByLevelA1 >= 0))
        && (!('completedByLevelA2' in profile) || (profile.completedByLevelA2 is int && profile.completedByLevelA2 >= 0))
        && (!('completedByLevelB1' in profile) || (profile.completedByLevelB1 is int && profile.completedByLevelB1 >= 0))
        && (!('completedByLevelB2' in profile) || (profile.completedByLevelB2 is int && profile.completedByLevelB2 >= 0))
        && (!('completedByLevelC1' in profile) || (profile.completedByLevelC1 is int && profile.completedByLevelC1 >= 0))
        && (!('completedByLevelC2' in profile) || (profile.completedByLevelC2 is int && profile.completedByLevelC2 >= 0))
        && profile.skillMastery is map
        && profile.onboardingComplete is bool;
    }

    match /users/{userId} {
      allow read: if signedInAs(userId);
      allow create: if signedInAs(userId)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'cefrLevel', 'completedLessons',
          'completedByLevelA1', 'completedByLevelA2', 'completedByLevelB1',
          'completedByLevelB2', 'completedByLevelC1', 'completedByLevelC2',
          'skillMastery', 'onboardingComplete', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'displayName', 'email', 'cefrLevel', 'completedLessons',
          'completedByLevelA1', 'completedByLevelA2', 'completedByLevelB1',
          'completedByLevelB2', 'completedByLevelC1', 'completedByLevelC2',
          'skillMastery', 'onboardingComplete', 'createdAt', 'updatedAt'
        ])
        && validProfile(request.resource.data, userId);

      // Purchase/entitlement fields are deliberately not client-writable.
      allow update: if signedInAs(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'cefrLevel', 'completedLessons',
          'completedByLevelA1', 'completedByLevelA2', 'completedByLevelB1',
          'completedByLevelB2', 'completedByLevelC1', 'completedByLevelC2',
          'skillMastery', 'onboardingComplete', 'lastStudiedAt', 'updatedAt'
        ])
        && validProfile(request.resource.data, userId);
      // Hesap silme (Google Play zorunlulugu): kullanici yalnizca kendi profilini silebilir.
      allow delete: if signedInAs(userId);

      match /lessonEvents/{eventId} {
        allow read: if signedInAs(userId);
        allow create: if signedInAs(userId)
          && request.resource.data.keys().hasOnly(['lessonId', 'score', 'completedAt'])
          && request.resource.data.keys().hasAll(['lessonId', 'completedAt'])
          && request.resource.data.lessonId is string
          && request.resource.data.lessonId.size() > 0
          && (!('score' in request.resource.data)
            || (request.resource.data.score is int
              && request.resource.data.score >= 0
              && request.resource.data.score <= 100));
        allow update: if false;
        // Hesap silme temizligi: kullanici kendi ders gecmisini silebilir.
        allow delete: if signedInAs(userId);
      }

      // Arkadas listesi: yalnizca sahibi okur/yazar/siler.
      match /friends/{friendId} {
        allow read, create, update, delete: if signedInAs(userId);
      }
    }

    // Lig tablosu: herkes okur (giris sartiyla), kullanici yalnizca kendi kaydini yazar.
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow create, update: if signedInAs(userId)
        && request.resource.data.uid == userId
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 200
        && request.resource.data.totalXp is int
        && request.resource.data.totalXp >= 0
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 120;
      allow delete: if signedInAs(userId);
    }

    // Bulten: kullanici kendi adina kisa basari kaydi ekler; herkes okur, kimse duzenleyemez.
    match /activity/{itemId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'username', 'avatar', 'text', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 20
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 120
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 140
        && request.resource.data.createdAt is int;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Kullanici adi rezervasyonu: ilk alan kazanir; belge bir daha degistirilemez, sahibi silebilir.
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && name.size() >= 3
        && name.size() <= 20;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Courses are versioned app content; never client-writable.
    match /courseContent/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
