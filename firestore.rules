rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function activeAccount(userId) {
      return signedInAs(userId)
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.get('deletionRequested', false) == false;
    }

    function validLevel(level) {
      return level in ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'];
    }

    function validProfile(profile, userId) {
      return profile.uid == userId
        && profile.displayName is string
        && profile.displayName.size() > 0
        && profile.displayName.size() <= 80
        && profile.email is string
        && profile.email.size() <= 254
        && validLevel(profile.cefrLevel)
        && profile.completedLessons is int
        && profile.completedLessons >= 0
        && (!('completedByLevelA1' in profile) || (profile.completedByLevelA1 is int && profile.completedByLevelA1 >= 0))
        && (!('completedByLevelA2' in profile) || (profile.completedByLevelA2 is int && profile.completedByLevelA2 >= 0))
        && (!('completedByLevelB1' in profile) || (profile.completedByLevelB1 is int && profile.completedByLevelB1 >= 0))
        && (!('completedByLevelB2' in profile) || (profile.completedByLevelB2 is int && profile.completedByLevelB2 >= 0))
        && (!('completedByLevelC1' in profile) || (profile.completedByLevelC1 is int && profile.completedByLevelC1 >= 0))
        && (!('completedByLevelC2' in profile) || (profile.completedByLevelC2 is int && profile.completedByLevelC2 >= 0))
        && profile.skillMastery is map
        && profile.onboardingComplete is bool;
    }

    match /users/{userId} {
      allow read: if signedInAs(userId);
      allow create: if signedInAs(userId)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'cefrLevel', 'completedLessons',
          'completedByLevelA1', 'completedByLevelA2', 'completedByLevelB1',
          'completedByLevelB2', 'completedByLevelC1', 'completedByLevelC2',
          'skillMastery', 'onboardingComplete', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'displayName', 'email', 'cefrLevel', 'completedLessons',
          'completedByLevelA1', 'completedByLevelA2', 'completedByLevelB1',
          'completedByLevelB2', 'completedByLevelC1', 'completedByLevelC2',
          'skillMastery', 'onboardingComplete', 'createdAt', 'updatedAt'
        ])
        && validProfile(request.resource.data, userId);

      // Purchase/entitlement fields are deliberately not client-writable.
      allow update: if activeAccount(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'cefrLevel', 'completedLessons',
          'completedByLevelA1', 'completedByLevelA2', 'completedByLevelB1',
          'completedByLevelB2', 'completedByLevelC1', 'completedByLevelC2',
          'skillMastery', 'onboardingComplete', 'lastStudiedAt', 'updatedAt'
        ])
        && validProfile(request.resource.data, userId);
      // Account deletion must use the reauthenticated callable, which removes all related data.
      // Admin SDK cleanup bypasses these client rules.
      allow delete: if false;

      match /lessonEvents/{eventId} {
        allow read: if signedInAs(userId);
        allow create: if activeAccount(userId)
          && request.resource.data.keys().hasOnly(['lessonId', 'score', 'completedAt', 'clientCompletedAtEpochMillis'])
          && request.resource.data.keys().hasAll(['lessonId', 'completedAt'])
          && request.resource.data.completedAt == request.time
          && (!('clientCompletedAtEpochMillis' in request.resource.data)
            || (request.resource.data.clientCompletedAtEpochMillis is int
              && request.resource.data.clientCompletedAtEpochMillis >= 0
              && request.resource.data.clientCompletedAtEpochMillis <= 253402300799999))
          && request.resource.data.lessonId is string
          && request.resource.data.lessonId.size() > 0
          && (!('score' in request.resource.data)
            || (request.resource.data.score is int
              && request.resource.data.score >= 0
              && request.resource.data.score <= 100));
        allow update: if false;
        // Hesap silme temizligi: kullanici kendi ders gecmisini silebilir.
        allow delete: if signedInAs(userId);
      }

      // Stable lesson ids make retries and repeated lessons count once toward the course.
      match /lessonCompletions/{lessonId} {
        allow read, delete: if signedInAs(userId);
        allow create: if activeAccount(userId)
          && request.resource.data.keys().hasOnly(['lessonId', 'score', 'completedAt', 'clientCompletedAtEpochMillis'])
          && request.resource.data.keys().hasAll(['lessonId', 'completedAt'])
          && request.resource.data.lessonId == lessonId
          && request.resource.data.completedAt == request.time
          && (!('clientCompletedAtEpochMillis' in request.resource.data)
            || (request.resource.data.clientCompletedAtEpochMillis is int
              && request.resource.data.clientCompletedAtEpochMillis >= 0
              && request.resource.data.clientCompletedAtEpochMillis <= 253402300799999))
          && (!('score' in request.resource.data)
            || (request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 100));
        allow update: if false;
      }

      match /private/{document} {
        allow read: if signedInAs(userId);
        allow write: if false;
      }
      match /xpAwards/{awardId} {
        allow read: if signedInAs(userId);
        allow write: if false;
      }

      // Arkadas listesi: yalnizca sahibi okur/yazar/siler.
      match /friends/{friendId} {
        allow read, delete: if signedInAs(userId);
        allow create, update: if activeAccount(userId)
          && friendId != userId
          && exists(/databases/$(database)/documents/users/$(friendId))
          && get(/databases/$(database)/documents/users/$(friendId)).data.get('deletionRequested', false) == false
          && request.resource.data.keys().hasOnly(['uid', 'username', 'avatar', 'addedAt'])
          && request.resource.data.uid == friendId
          && request.resource.data.username is string
          && request.resource.data.username.size() <= 20
          && request.resource.data.avatar is string
          && request.resource.data.avatar.size() <= 120
          && request.resource.data.addedAt is int;
      }
    }

    // Lig tablosu: herkes okur (giris sartiyla), kullanici yalnizca kendi kaydini yazar.
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      function ownsUsername() {
        return request.resource.data.username.matches('[a-z0-9_.]{3,20}')
          && get(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == userId;
      }
      function validIdentity() {
        return request.resource.data.uid == userId
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 40
          && request.resource.data.avatar is string
          && request.resource.data.avatar.size() <= 120
          && ownsUsername();
      }
      // Ranked scores are written only by the trusted backend, never supplied by the app.
      allow create: if activeAccount(userId) && validIdentity()
        && request.resource.data.keys().hasOnly(['uid', 'username', 'displayName', 'avatar']);
      allow update: if activeAccount(userId) && validIdentity()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'displayName', 'avatar']);
      allow delete: if signedInAs(userId);
    }

    // Bulten: kullanici kendi adina kisa basari kaydi ekler; herkes okur, kimse duzenleyemez.
    match /activity/{itemId} {
      allow read: if request.auth != null;
      // Only the callable publishes fixed templates with a server timestamp and daily cap.
      allow create: if false;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Kullanici adi rezervasyonu: ilk alan kazanir; belge bir daha degistirilemez, sahibi silebilir.
    match /usernames/{name} {
      allow read: if request.auth != null;
      // The callable enforces one current name per learner and releases old aliases atomically.
      allow create, update, delete: if false;
    }

    // Courses are versioned app content; never client-writable.
    match /courseContent/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

